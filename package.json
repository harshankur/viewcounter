{
  "name": "@harshankur/viewcounter",
  "description": "A middleware backend server that registers views to my db server when requested to register a view from my other projects.",
  "version": "3.1.0",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "index.js",
    "constants.js",
    "admin/",
    "config/",
    "db/",
    "middleware/",
    "routes/",
    "utils/",
    "scripts/setup.js",
    ".env.example",
    "allowed.sample.json",
    "dbInfo.sample.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node index.js",
    "setup": "node scripts/setup.js",
    "assets": "node scripts/generate-brand-assets.js",
    "map": "node scripts/generate-world-map.js",
    "admin:demo": "node tests/ui/server.js 4173 --demo",
    "lint": "eslint .",
    "test": "npm run lint && jest --coverage --verbose && playwright test && node scripts/generate-test-report.js",
    "test:ui": "playwright test",
    "test:watch": "jest --watch",
    "test:ci": "npm run lint && jest --coverage --ci",
    "test:persist": "PERSIST_TEST_DB=true jest --coverage --verbose && node scripts/generate-test-report.js",
    "test:e2e": "bash tests/e2e/matrix.sh",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "i18n-iso-countries": "^7.14.0",
    "jest": "^30.4.2",
    "jest-html-reporter": "^4.4.0",
    "supertest": "^7.2.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshankur/viewcounter.git"
  },
  "keywords": [
    "viewcounter",
    "analytics",
    "tracking",
    "mysql",
    "middleware",
    "privacy-first"
  ],
  "author": "Harsh Ankur",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/harshankur/viewcounter/issues"
  },
  "homepage": "https://viewcounter.harshankur.com",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "geoip-country": "^5.0.202609230144",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "ua-parser-js": "^2.0.10",
    "url-parse": "^1.5.10"
  },
  "overrides": {
    "ip-address": "^10.7.2"
  }
}

// viewcounter edge Worker: counts page views server to server, without
// anything running in the visitor's browser (see src/index.js).
//
// Deployed with Cloudflare Workers Builds, root directory "edge/", or by hand
// with `npx wrangler deploy` from this folder.
//
// The secret is not here: set it in the dashboard (Workers, viewcounter-edge,
// Settings, Variables and Secrets) or with `npx wrangler secret put EDGE_SECRET`,
// to the same value as the server's EDGE_SECRET.
//
// The routes and SITES below are the viewcounter author's own sites. Anyone
// else replaces both with their own: a route for each site the Worker should
// stand in front of (its zone must be on Cloudflare, with the DNS record
// proxied), and SITES mapping each hostname to the app ID its views are
// stored under. The site of every app must be in that app's `origins` in the
// server's allowed.json, or its reports are refused. A site whose pages differ
// only in their query names those parameters, as the blog does with
// {"app": "blog", "query": ["post"]} (the tracker's data-query): they are
// reported as part of the page, and the rest of the query never is. LiD
// Practice sends no language ("language": false): its visitors' language could
// hint at their origin, and the server keeps none for it (NO_LANGUAGE_APPS).
//
// Two optional vars match the tracker's options of the same meaning:
// "RESPECT_DNT": "true" reports nothing for a browser sending Do Not Track or
// Global Privacy Control (data-respect-dnt), and "CAMPAIGNS": "false" leaves
// the URL's utm_* tags out (data-campaigns).
{
    "name": "viewcounter-edge",
    "main": "src/index.js",
    "compatibility_date": "2026-10-01",
    // No usage data to Cloudflare from wrangler, and no other way in than the routes.
    "send_metrics": false,
    "workers_dev": false,
    "preview_urls": false,
    "vars": {
        "VIEWCOUNTER_URL": "https://views.harshankur.com",
        // A browser sending Do Not Track or Global Privacy Control has objected: nothing is reported for it.
        "RESPECT_DNT": "true",
        // hostname -> appId, hostname -> { app, query }, or hostname -> [{ prefix, app, query? }]:
        // the longest matching prefix wins; "query" names the parameters that are part of a page.
        "SITES": "{\"harshankur.com\":\"homepage\",\"viewcounter.harshankur.com\":\"viewcounter\",\"officeparser.harshankur.com\":[{\"prefix\":\"/blog/\",\"app\":\"officeparserblog\"},{\"prefix\":\"/\",\"app\":\"officeparser\"}],\"inscript.harshankur.com\":\"inscript\",\"inscript-editor.harshankur.com\":\"inscript-editor\",\"blog.harshankur.com\":{\"app\":\"blog\",\"query\":[\"post\"]},\"balloonpop.harshankur.com\":\"balloonpop\",\"pdfstitch.com\":\"pdfstitch\",\"lidpractice.de\":{\"app\":\"lidpractice\",\"language\":false}}"
    },
    "routes": [
        { "pattern": "harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "viewcounter.harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "officeparser.harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "inscript.harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "inscript-editor.harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "blog.harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "balloonpop.harshankur.com/*", "zone_name": "harshankur.com" },
        { "pattern": "pdfstitch.com/*", "zone_name": "pdfstitch.com" },
        { "pattern": "lidpractice.de/*", "zone_name": "lidpractice.de" }
    ]
}
